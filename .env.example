# Copy to `.env` for local development. Never commit `.env`.

# --- Flask backend (backend/app.py) ---
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Optional: restrict browser origins allowed to call Flask directly
ALLOWED_ORIGINS=*

# --- Frontend / SSR proxy ---
# URL of the running Flask backend (used by src/routes/api/chat.ts)
CHAT_BACKEND_URL=http://127.0.0.1:5001
# Optional: make the browser call Flask directly instead of the proxy
# VITE_CHAT_API_URL=https://your-service.a.run.app/api/chat
